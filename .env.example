# Copie para .env (local) ou cadastre estas variáveis no painel da hospedagem.
# NUNCA coloque valores reais neste arquivo nem no Git.

# development (padrão) ou production
LOJA_ENV=production

# Pasta do disco persistente onde ficam loja.db e backups/. OBRIGATÓRIA em produção.
LOJA_DATA_DIR=/data

# Senha inicial do usuário "admin" (mín. 10 caracteres). Só vale na criação do banco; o sistema obriga a trocar no 1º acesso.
LOJA_ADMIN_PASSWORD=

# Opcional: chave de sessão (mín. 32 caracteres). Se vazia, é gerada e guardada em LOJA_DATA_DIR/secret.key.
LOJA_SECRET_KEY=

# Opcional: endereço público (ex.: https://loja.exemplo.com). Usado na validação de origem.
LOJA_PUBLIC_URL=

# Opcional: 1 (padrão em produção) quando há proxy/HTTPS na frente do sistema.
LOJA_TRUST_PROXY=1

# A hospedagem normalmente define PORT sozinha. Local: LOJA_PORT (padrão 5000) e LOJA_HOST (padrão 127.0.0.1).
# PORT=
# LOJA_PORT=5000
# LOJA_HOST=127.0.0.1
# LOJA_NO_BROWSER=1
